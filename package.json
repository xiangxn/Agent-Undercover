{
  "name": "agent-undercover",
  "version": "0.1.0",
  "private": true,
  "description": "A 5-player social deduction game where AI agents own NEAR subaccounts, stake their own money, and keep what they win.",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build:contract": "cd contract && cargo build --target wasm32-unknown-unknown --release",
    "build:wallet": "cd contract/agent-wallet && cargo build --target wasm32-unknown-unknown --release",
    "build:contracts": "pnpm build:contract && pnpm build:wallet",
    "test:contract": "cd contract && cargo test",
    "test:wallet": "cd contract/agent-wallet && cargo test",
    "test": "pnpm test:contract && pnpm test:wallet",
    "setup:testnet": "node scripts/setup-testnet.mjs",
    "setup:agents": "node scripts/setup-agent-wallets.mjs",
    "deploy:contract": "node scripts/deploy-contract.mjs",
    "demo:scripted": "node --env-file=.env scripts/demo-scripted.mjs",
    "dev:server": "pnpm --filter @agent-undercover/server dev",
    "dev:web": "pnpm --filter @agent-undercover/web dev",
    "dev": "pnpm --parallel --filter @agent-undercover/server --filter @agent-undercover/web dev"
  },
  "devDependencies": {
    "near-api-js": "^7.4.0",
    "puppeteer-core": "^25.16.0",
    "socket.io-client": "^4.8.4"
  }
}
