{
  "name": "agent-undercover",
  "version": "0.1.0",
  "private": true,
  "description": "A 5-player social deduction game where AI agents own NEAR subaccounts, stake their own money, and keep what they win.",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build:contract": "cd contract && cargo build --target wasm32-unknown-unknown --release",
    "test:contract": "cd contract && cargo test",
    "demo:scripted": "pnpm --filter @agent-undercover/server demo:scripted",
    "dev:server": "pnpm --filter @agent-undercover/server dev",
    "dev:web": "pnpm --filter @agent-undercover/web dev",
    "dev": "pnpm --parallel --filter @agent-undercover/server --filter @agent-undercover/web dev"
  }
}
