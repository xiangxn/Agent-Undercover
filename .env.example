# Copy to .env and fill in. Never commit .env or any key material.

# --- NEAR network ---
NEAR_NETWORK=testnet
# fastnear has been more reliable from some networks; rpc.testnet.near.org also works
NEAR_RPC_URL=https://test.rpc.fastnear.com

# --- Operator / game master ---
# Full-access key. Local only.
MASTER_ACCOUNT_ID=agent-undercover.testnet
MASTER_PRIVATE_KEY=ed25519:REPLACE_ME

# --- Game contract ---
CONTRACT_ACCOUNT_ID=game.agent-undercover.testnet

# --- Treasury (funds disposable human sessions + agent top-ups) ---
# Full-access key. Testnet only. Local only.
TREASURY_ACCOUNT_ID=au-treasury.testnet
TREASURY_PRIVATE_KEY=ed25519:REPLACE_ME

# --- Persistent agent subaccounts ---
# Each agent uses a FunctionCall access key scoped to the game contract.
# Each agent has two scoped keys: game actions and its wallet's stake method.
AGENT_ALPHA_ACCOUNT_ID=alpha.agents.agent-undercover.testnet
AGENT_ALPHA_PRIVATE_KEY=ed25519:REPLACE_ME
AGENT_ALPHA_WALLET_PRIVATE_KEY=ed25519:REPLACE_ME
AGENT_BETA_ACCOUNT_ID=beta.agents.agent-undercover.testnet
AGENT_BETA_PRIVATE_KEY=ed25519:REPLACE_ME
AGENT_BETA_WALLET_PRIVATE_KEY=ed25519:REPLACE_ME
AGENT_GAMMA_ACCOUNT_ID=gamma.agents.agent-undercover.testnet
AGENT_GAMMA_PRIVATE_KEY=ed25519:REPLACE_ME
AGENT_GAMMA_WALLET_PRIVATE_KEY=ed25519:REPLACE_ME
AGENT_DELTA_ACCOUNT_ID=delta.agents.agent-undercover.testnet
AGENT_DELTA_PRIVATE_KEY=ed25519:REPLACE_ME
AGENT_DELTA_WALLET_PRIVATE_KEY=ed25519:REPLACE_ME

# 0.1 NEAR in yoctoNEAR
AGENT_STAKE_YOCTO=100000000000000000000000
AGENT_INITIAL_BALANCE_NEAR=2.4

# --- Backend ---
PORT=8787
WEB_ORIGIN=http://localhost:5173
# Testnet NEAR sent to a new human session account.
# 0.25 covers the 0.1 stake, ~0.1 of room storage, and gas; below 0.22 the
# session cannot open a room and the server refuses to boot.
SESSION_FUNDING_NEAR=0.25
# Refill threshold/amount for a returning session or agent wallet
SESSION_TOPUP_NEAR=0.2
AGENT_MIN_BALANCE_NEAR=0.30
AGENT_TOPUP_NEAR=0.20
# Refuse new sessions below this treasury balance (keeps a public demo solvent)
TREASURY_FLOOR_NEAR=0.5
# Max in-memory game sessions before new ones are refused
MAX_SESSIONS=100

# --- AI ---
# scripted: deterministic, no API key. live: NEAR AI Cloud.
DEMO_MODE=scripted
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=
NEAR_AI_MODEL=z-ai/glm-5.3-flash
# Reasoning models otherwise spend the whole completion budget thinking and
# return empty content. "low" keeps a turn around 2-3s; leave empty if the
# model does not accept the parameter.
NEAR_AI_REASONING_EFFORT=low

# --- Web (Vite) ---
VITE_API_URL=http://localhost:8787
VITE_CONTRACT_ACCOUNT_ID=game.agent-undercover.testnet
